{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨台",
  "version": "0.6.1",
  "identifier": "local.markdown-desk.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "墨台 · Markdown 工作台",
        "theme": "Dark",
        "visible": false,
        "backgroundColor": "#202020",
        "width": 1440,
        "height": 960,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "title": "墨台 · 正在启动",
        "width": 900,
        "height": 600,
        "center": true,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "noRedirectionBitmap": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https: http:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; frame-src 'self' about: blob:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
